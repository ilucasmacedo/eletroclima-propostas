  "formulas": [
    {
      "codigo": "FAIXA_KWP",
      "nome": "Busca de faixa por kWp",
      "expressao": "faixa onde kwp > kwp_min E kwp <= kwp_max",
      "regra_intervalo": "(min, max] — limite inferior exclusivo, superior inclusivo",
      "entradas": ["kwp"],
      "saida": "faixa_kwp"
    },
    {
      "codigo": "MENSALIDADE",
      "nome": "Mensalidade do plano",
      "expressao": "faixas_kwp[faixa(kwp)].precos[plano]",
      "entradas": ["kwp", "plano"],
      "saida": "R$/mês",
      "condicoes_sob_consulta": ["kwp > 500", "plano = NENHUM → null"]
    },
    {
      "codigo": "DESLOCAMENTO",
      "nome": "Taxa de deslocamento",
      "expressao": "km = ceil(distancia_km); km_excedente = max(0, km - 50); valor = km_excedente × taxa_faixa(km)",
      "entradas": ["distancia_km"],
      "saida": "R$",
      "condicoes": ["km <= 50 → valor = 0", "km > 600 → sob consulta"]
    },
    {
      "codigo": "SERVICO_FIXO",
      "nome": "Serviço avulso — valor fixo",
      "expressao": "preco = fora_plano",
      "entradas": ["codigo_servico"],
      "saida": "R$"
    },
    {
      "codigo": "SERVICO_PERCENTUAL",
      "nome": "Seguro — percentual do contrato",
      "expressao": "preco = valor_contrato × 0.02",
      "entradas": ["valor_contrato"],
      "saida": "R$"
    },
    {
      "codigo": "TOTAL_AVULSOS",
      "nome": "Total de itens avulsos",
      "expressao": "total = Σ servicos + deslocamento_global",
      "entradas": ["servicos_selecionados", "distancia_km"],
      "saida": "R$"
    },
    {
      "codigo": "PRIMEIRA_COBRANCA",
      "nome": "Primeira cobrança da proposta",
      "expressao": "primeira = (mensalidade || 0) + total_avulsos",
      "entradas": ["mensalidade", "total_avulsos"],
      "saida": "R$"
    }
  ],

