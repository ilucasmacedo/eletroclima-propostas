  "formulas": [
    {
      "codigo": "DESLOCAMENTO",
      "expressao": "km = ceil(distancia); se km <= 50 → isento; senão valor = km × taxa_faixa",
      "condicoes": ["km <= 50 → isento", "km > 600 → sob consulta"]
    },
    {
      "codigo": "DESCONTO_AVULSO",
      "expressao": "preco = fora_plano × (1 - percentual_desconto_avulso/100)",
      "condicoes": ["PADRAO → 5%", "PREMIUM → 10%", "ACESSO → 0%", "SEGURO → sem desconto"]
    },
    {
      "codigo": "MANUT_PREVENTIVA",
      "expressao": "preco = 30 × qtd_modulos",
      "condicoes": ["+ deslocamento quando presencial"]
    },
    {
      "codigo": "PRIMEIRA_COBRANCA",
      "expressao": "mensalidade + servicos + deslocamento_global"
    }
  ],

