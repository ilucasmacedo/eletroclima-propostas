# Groner CRM — credenciais da API (nunca commitar o .env real)
# Gere token longo: POST https://{tenant}.api.groner.app/api/Conta/GerarToken

GRONER_TENANT=eletroclima
GRONER_TOKEN=seu-token-jwt-aqui

# Só para gerar token: node scripts/gerar-token-groner.mjs (não commitar senha)
# GRONER_EMAIL=integracao@eletroclima.com.br
# GRONER_SENHA=

# Pré-venda — cadastro automático quando cliente não veio da busca Groner
GRONER_ORIGEM_PRE_VENDA_ID=57
GRONER_TIPO_PROJETO_PRE_VENDA_ID=223

# Opcional: IDs dos campos personalizados (sobrescreve config/groner-integracao.json)
# Descobrir IDs: node scripts/listar-campos-groner.mjs
# GRONER_CAMPO_KWP_ID=
# GRONER_CAMPO_QTD_PLACAS_ID=
# GRONER_CAMPO_DISTANCIA_KM_ID=
# GRONER_CAMPO_PLANO_ID=
# GRONER_CAMPO_MENSALIDADE_ID=
# GRONER_CAMPO_VALOR_TOTAL_PROPOSTA_ID=
# GRONER_CAMPO_TOTAL_AVULSOS_ID=
# GRONER_CAMPO_VALOR_TOTAL_SISTEMA_ID=
# GRONER_CAMPO_VALOR_CONTRATO_ID=
# GRONER_CAMPO_DESCRICAO_PROPOSTA_ID=
# GRONER_CAMPO_PDF_PROPOSTA_ID=
# GRONER_ABA_DINAMICA_ID=2

# Porta da API local (npm run dev:api)
API_PORT=3001
